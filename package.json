{
  "name": "velqu-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "examples/proof",
    "benchmarks/harness"
  ],
  "scripts": {
    "verify": "./scripts/verify",
    "validate-okf": "./scripts/validate-okf",
    "benchmark:all": "./scripts/benchmark",
    "package:archive": "./scripts/package",
    "test": "bun test packages examples/proof",
    "typecheck": "tsc -b tsconfig.json",
    "velqu": "bun packages/cli/src/index.ts",
    "packages:build": "bun scripts/build-packages.ts",
    "publish:beta": "bash scripts/publish-beta.sh --dry-run",
    "publish:beta:real": "bash scripts/publish-beta.sh"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.3.4"
  }
}
