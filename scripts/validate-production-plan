#!/usr/bin/env python3
import json
import re
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
obj = json.loads((root / 'TASKS.production.json').read_text())
ids = [t['id'] for t in obj['tasks']]
errors = []
if len(ids) != len(set(ids)):
    errors.append('duplicate task IDs')
known = set(ids)
by = {t['id']: t for t in obj['tasks']}
head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()

def commit_exists(value):
    if not re.fullmatch(r'[0-9a-f]{40}', str(value or '')):
        return False
    return subprocess.run(
        ['git', 'cat-file', '-e', f'{value}^{{commit}}'], cwd=root,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0

for t in obj['tasks']:
    for d in t['depends_on']:
        if d not in known:
            errors.append(f"{t['id']}: missing dependency {d}")
    if not t['acceptance'] or not t['evidence']:
        errors.append(f"{t['id']}: acceptance/evidence required")

    if t.get('status') != 'PASS':
        continue
    refs = t.get('evidence_refs')
    if not isinstance(refs, dict):
        errors.append(f"{t['id']}: PASS requires evidence_refs")
        continue
    ref_commit = refs.get('commit')
    if not commit_exists(ref_commit):
        errors.append(f"{t['id']}: PASS evidence commit must be an existing concrete 40-hex commit")
    elif subprocess.run(
        ['git', 'merge-base', '--is-ancestor', str(ref_commit), head],
        cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode != 0:
        errors.append(f"{t['id']}: evidence commit {ref_commit} is not an ancestor of HEAD {head}")

    def paths(name, required):
        value = refs.get(name)
        if required and not value:
            errors.append(f"{t['id']}: PASS requires evidence_refs.{name}")
            return
        if value is None:
            return
        values = value if isinstance(value, list) else [value]
        for raw in values:
            path = root / str(raw)
            if not path.exists():
                errors.append(f"{t['id']}: missing {name} path {raw}")
            if str(raw).startswith('history/') and not refs.get('historical', False):
                errors.append(f"{t['id']}: historical evidence must be explicitly marked historical: {raw}")

    paths('source', True)
    paths('rawEvidence', True)
    paths('report', True)
    tests = refs.get('tests')
    if not isinstance(tests, list) or not tests:
        errors.append(f"{t['id']}: PASS requires non-empty evidence_refs.tests")
    else:
        for test in tests:
            if not str(test).strip():
                errors.append(f"{t['id']}: empty test reference")

    for dep in t['depends_on']:
        if by[dep].get('status') != 'PASS':
            errors.append(f"{t['id']}: PASS dependency {dep} is {by[dep].get('status')}")

visiting = set()
done = set()
def visit(i):
    if i in done:
        return
    if i in visiting:
        errors.append(f'cycle at {i}')
        return
    visiting.add(i)
    for d in by[i]['depends_on']:
        visit(d)
    visiting.remove(i)
    done.add(i)
for i in ids:
    visit(i)

print(json.dumps({'production_tasks': len(ids), 'head': head, 'errors': errors}, indent=2))
sys.exit(1 if errors else 0)
