#!/usr/bin/env python3
"""Regenerate the Codex Spark queue indexes from packet statuses.

Reads every packet/gate file under docs/codex-spark-beta, keeps the ones whose
frontmatter status is TODO, and rewrites:

  - docs/codex-spark-beta/indexes/EXECUTION_QUEUE.md  (all unchecked)
  - docs/codex-spark-beta/indexes/NEXT_25.md          (first 25 unchecked)

Each entry carries the registered GitHub issue number (`— #N`) so a packet PR
can reference `Closes #N` without a manual lookup. Issue numbers come from
`gh issue list` by `[PACKET-ID]` title prefix; run while authenticated.

Usage: scripts/spark-queue [repo]   (default ther12k/velqu)
"""
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SPARK = ROOT / "docs" / "codex-spark-beta"
TASKS = SPARK / "tasks"
GATES = SPARK / "gates"


def frontmatter(text, key):
    m = re.search(rf"^{key}: (\S+)$", text, re.M)
    return m.group(1) if m else None


def packet_from(p, text, tid, status):
    title = re.search(rf"^# {re.escape(tid)} — (.+)$", text, re.M)
    deps = re.search(r"^## Dependencies\n\n(.*?)(?=\n\n)", text, re.M | re.S)
    dep_list = re.findall(r"^- `([A-Za-z0-9-]+)`", deps.group(1), re.M) if deps else []
    return {
        "id": tid,
        "title": title.group(1) if title else tid,
        "status": status,
        "milestone": frontmatter(text, "milestone"),
        "rel": p.relative_to(SPARK),
        "deps": ", ".join(dep_list) if dep_list else "—",
        "kind": "gate" if p.parent == GATES else "task",
    }


def load_packets():
    # Task directories (00_g0…, 01_m24…, … 08_public_beta) already encode
    # roadmap order; each milestone's gate follows that milestone's tasks.
    tasks = []
    gates = {}
    for p in sorted(TASKS.glob("*/*.md")):
        text = p.read_text()
        tid = frontmatter(text, "task_id")
        status = frontmatter(text, "status")
        if tid and status:
            tasks.append(packet_from(p, text, tid, status))
    for p in sorted(GATES.glob("*.md")):
        text = p.read_text()
        tid = frontmatter(text, "task_id")
        status = frontmatter(text, "status")
        if tid and status:
            gates[frontmatter(text, "milestone")] = packet_from(p, text, tid, status)

    ordered = []
    milestones = []
    by_ms = {}
    for t in tasks:
        ms = t["milestone"]
        if ms not in by_ms:
            by_ms[ms] = []
            milestones.append(ms)
        by_ms[ms].append(t)
    for ms in milestones:
        ordered.extend(by_ms[ms])
        if ms in gates:
            ordered.append(gates.pop(ms))
    ordered.extend(gates.values())  # milestones without tasks (unexpected)
    return ordered


def issue_map(repo):
    out = subprocess.run(
        ["gh", "issue", "list", "-R", repo, "--state", "all", "--limit", "2000",
         "--json", "number,title"],
        capture_output=True, text=True, check=True,
    ).stdout
    mapping = {}
    for it in json.loads(out):
        m = re.match(r"^\[([A-Za-z0-9-]+)\]", it["title"])
        if m:
            mapping[m.group(1)] = it["number"]
    return mapping


def entry(n, p, issues):
    ref = f"— #{issues[p['id']]}" if p["id"] in issues else "— (no issue)"
    return f"{n}. [{p['id']} — {p['title']}]({p['rel']}) — deps: {p['deps']} {ref}"


def write(path, heading, intro, selected, issues):
    lines = [heading, "", intro, ""]
    for i, p in enumerate(selected, 1):
        lines.append(entry(i, p, issues))
    path.write_text("\n".join(lines) + "\n")


def main():
    repo = sys.argv[1] if len(sys.argv) > 1 else "ther12k/velqu"
    packets = load_packets()
    todo = [p for p in packets if p["status"] == "TODO"]
    issues = issue_map(repo)
    unregistered = [p["id"] for p in todo if p["id"] not in issues]
    if unregistered:
        print(f"ERROR: unchecked packets without GitHub issues: {unregistered}", file=sys.stderr)
        sys.exit(1)
    head = todo[0]["id"] if todo else "(none)"
    write(
        SPARK / "indexes" / "EXECUTION_QUEUE.md",
        "# Dependency-Safe Execution Queue",
        f"All PASS packets are omitted. The first unchecked dependency-ready task is {head}; "
        "future milestone tasks remain TODO until implemented and evidenced.",
        todo, issues,
    )
    write(
        SPARK / "indexes" / "NEXT_25.md",
        "# Next 25 Dependency-Safe Tasks",
        f"The next dependency-ready implementation task is {head}; this short queue lists the "
        "first 25 unchecked packets with their issue numbers.",
        todo[:25], issues,
    )
    print(json.dumps({"total_packets": len(packets), "unchecked": len(todo), "first": head}))


if __name__ == "__main__":
    main()
