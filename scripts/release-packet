#!/usr/bin/env bash
# Build a self-verifying release packet from the CURRENT commit.
# Artifacts land in release/ (untracked). sha256sum -c SHA256SUMS.txt
# must pass from inside release/ — the manifest lists only shipped files.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -n "$(git status --porcelain)" ]]; then
  echo "release packet requires a clean working tree" >&2
  exit 1
fi
COMMIT=$(git rev-parse HEAD)
SHORT=$(git rev-parse --short "$COMMIT")
OUT=release
rm -rf "$OUT" && mkdir -p "$OUT"

echo "$COMMIT" > "$OUT/SOURCE-COMMIT.txt"
git bundle create "$OUT/velqu-${SHORT}.bundle" HEAD master
git archive --format=zip --prefix="velqu-${SHORT}/" -o "$OUT/source-${SHORT}.zip" HEAD
cp benchmarks/manifest.json "$OUT/BENCHMARK_MANIFEST.json"
if [[ -f docs/beta/CHANGELOG.md ]]; then
  cp docs/beta/CHANGELOG.md "$OUT/CHANGELOG.md"
fi

# Indexes are generated after HEAD is fixed; never copy a possibly stale
# working-tree index into the release packet.
python3 - "$COMMIT" "$OUT" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

commit, out = sys.argv[1:]
root = Path.cwd()
generated = datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')
for name in ('REVIEW_INDEX.json', 'EVIDENCE_INDEX.json'):
    source = root / name
    if not source.is_file():
        raise SystemExit(f'missing index template: {name}')
    data = json.loads(source.read_text())
    data['commit'] = commit
    data['generatedAt'] = generated
    data['releaseCommit'] = commit
    (Path(out) / name).write_text(json.dumps(data, indent=2) + '\n')
PY

# The generated indexes must be bound to this exact source commit.
for f in "$OUT/REVIEW_INDEX.json" "$OUT/EVIDENCE_INDEX.json"; do
  grep -q "\\\"commit\\\": \\\"$COMMIT\\\"" "$f"
done

(
  cd "$OUT"
  : > SHA256SUMS.txt
  FILES=(SOURCE-COMMIT.txt "velqu-${SHORT}.bundle" "source-${SHORT}.zip" BENCHMARK_MANIFEST.json REVIEW_INDEX.json EVIDENCE_INDEX.json)
  if [[ -f CHANGELOG.md ]]; then
    FILES+=(CHANGELOG.md)
  fi
  for f in "${FILES[@]}"; do
    sha256sum "$f" >> SHA256SUMS.txt
  done
)

echo "release packet: commit ${SHORT}"
(cd "$OUT" && sha256sum -c SHA256SUMS.txt)
