#!/usr/bin/env bash
# Build a self-verifying release packet from the CURRENT commit.
# Artifacts land in release/ (untracked). sha256sum -c SHA256SUMS.txt
# must pass from inside release/ — the manifest lists only shipped files.
#
# #1321 / M8-003: supports detached OpenPGP manifest signing via --sign
# or VELQU_SIGN_RELEASE=1. When enabled, SHA256SUMS.txt is signed producing
# SHA256SUMS.txt.asc, and the packet is immediately verified against the
# trusted publisher key before completion. Fails closed if signing fails.
set -euo pipefail
cd "$(dirname "$0")/.."

SIGN=0
GPG_KEY="${VELQU_GPG_KEY:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --sign)
      SIGN=1
      shift
      ;;
    --key)
      GPG_KEY="$2"
      SIGN=1
      shift 2
      ;;
    -h|--help)
      echo "Usage: scripts/release-packet [--sign] [--key <key-id-or-fpr>]"
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ "${VELQU_SIGN_RELEASE:-0}" == "1" ]]; then
  SIGN=1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "release packet requires a clean working tree" >&2
  exit 1
fi
COMMIT=$(git rev-parse HEAD)
SHORT=$(git rev-parse --short "$COMMIT")
OUT=release
rm -rf "$OUT" && mkdir -p "$OUT"

echo "$COMMIT" > "$OUT/SOURCE-COMMIT.txt"
git bundle create "$OUT/velqu-${SHORT}.bundle" HEAD master
git archive --format=zip --prefix="velqu-${SHORT}/" -o "$OUT/source-${SHORT}.zip" HEAD
cp benchmarks/manifest.json "$OUT/BENCHMARK_MANIFEST.json"
if [[ -f docs/beta/CHANGELOG.md ]]; then
  cp docs/beta/CHANGELOG.md "$OUT/CHANGELOG.md"
fi
if [[ -f docs/beta/KNOWN-LIMITATIONS.md ]]; then
  cp docs/beta/KNOWN-LIMITATIONS.md "$OUT/KNOWN-LIMITATIONS.md"
fi

# BETA-015-C: the packet ships the Linux x86_64 release binary. It must be
# built from this exact tree (cargo build --release -p velqu-runtime with the
# reproducibility path remap); a missing or stale binary fails closed.
RUNTIME_BIN=target/release/velqu-runtime
[[ -x "$RUNTIME_BIN" ]] || {
  echo "release packet requires ${RUNTIME_BIN} (build it from this tree first)" >&2
  exit 1
}
cp "$RUNTIME_BIN" "$OUT/velqu-runtime"

# BETA-015-E: the packet also ships the QPack tooling binary (q-bytecode-tool)
# so bytecode embedding/migration ships with the runtime it must match.
BYTECODE_BIN=target/release/velqu-bytecode
[[ -x "$BYTECODE_BIN" ]] || {
  echo "release packet requires ${BYTECODE_BIN} (cargo build --release -p q-bytecode-tool)" >&2
  exit 1
}
cp "$BYTECODE_BIN" "$OUT/velqu-bytecode"

# Indexes are generated after HEAD is fixed; never copy a possibly stale
# working-tree index into the release packet.
python3 - "$COMMIT" "$OUT" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

commit, out = sys.argv[1:]
root = Path.cwd()
generated = datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')
for name in ('REVIEW_INDEX.json', 'EVIDENCE_INDEX.json'):
    source = root / name
    if not source.is_file():
        raise SystemExit(f'missing index template: {name}')
    data = json.loads(source.read_text())
    data['commit'] = commit
    data['generatedAt'] = generated
    data['releaseCommit'] = commit
    (Path(out) / name).write_text(json.dumps(data, indent=2) + '\n')
PY

# The generated indexes must be bound to this exact source commit.
for f in "$OUT/REVIEW_INDEX.json" "$OUT/EVIDENCE_INDEX.json"; do
  grep -q "\\\"commit\\\": \\\"$COMMIT\\\"" "$f"
done

# BETA-015-F/G: compose the SBOM and the npm tarballs into the same release
# directory so ONE checksum manifest covers the whole packet.
./scripts/sbom.sh "$OUT/sbom.cdx.json" >/dev/null
./scripts/npm-package-tarballs.sh "$OUT/npm-tarballs" >/dev/null

# BETA-015-G: single top-level checksum manifest over every shipped file
# (packet artifacts, SBOM, and npm tarballs). Nested SHA256SUMS.txt files
# (e.g. npm-tarballs/SHA256SUMS.txt) ARE checksummed into the top-level manifest,
# while only the top-level manifest itself and its signature are excluded.
(
  cd "$OUT"
  find . -type f ! -path "./SHA256SUMS.txt" ! -path "./SHA256SUMS.txt.asc" | sed 's|^\./||' | LC_ALL=C sort |
    while IFS= read -r f; do
      sha256sum "$f"
    done > SHA256SUMS.txt
)

echo "release packet: commit ${SHORT}"
(cd "$OUT" && sha256sum -c SHA256SUMS.txt)
echo "CHECKSUMS-OK: $(grep -c . "$OUT/SHA256SUMS.txt") files covered"

# #1321 / M8-003: Artifact signing step
if [[ $SIGN -eq 1 ]]; then
  echo "Signing release manifest with OpenPGP detached signature..."
  if ! command -v gpg >/dev/null 2>&1; then
    echo "ERROR: gpg command not found, required for release signing." >&2
    exit 1
  fi

  if [[ -z "$GPG_KEY" ]]; then
    echo "ERROR: release signing requested (--sign) but no publisher key specified (--key or VELQU_GPG_KEY)." >&2
    echo "GnuPG requires an explicit authorized signer identity; failing closed (no silent fallback)." >&2
    exit 1
  fi

  # Use --local-user to explicitly enforce the chosen signer key (not --default-key which can silently fall back)
  GPG_ARGS=(--batch --yes --armor --detach-sign --local-user "$GPG_KEY")

  gpg "${GPG_ARGS[@]}" --output "$OUT/SHA256SUMS.txt.asc" "$OUT/SHA256SUMS.txt"
  echo "SIGNATURE-GENERATED: $OUT/SHA256SUMS.txt.asc"

  # Immediately self-verify with required signature and required signer key
  ./scripts/verify-release-packet.sh --packet-dir "$OUT" --require-signature --trusted-key "$GPG_KEY"
else
  # Verify checksums and completeness
  ./scripts/verify-release-packet.sh --packet-dir "$OUT"
fi

echo "RELEASE-PACKET-COMPLETE: $OUT/ is ready."
