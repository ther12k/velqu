{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Velqu Production Readiness Task Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "baseline",
    "status_values",
    "milestones",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "required": [
        "archive",
        "sha256"
      ]
    },
    "status_values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "milestones": {
      "type": "array"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "milestone",
          "lane",
          "priority",
          "title",
          "objective",
          "depends_on",
          "deliverables",
          "acceptance",
          "evidence",
          "owner",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "milestone": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "files_hint": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "BLOCKED",
              "PASS",
              "FAIL",
              "WAIVED"
            ]
          }
        }
      }
    }
  }
}
