{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@velqu/contract": [
        "packages/contract/dist/index.d.ts"
      ],
      "@velqu/schema": [
        "packages/schema/dist/index.d.ts"
      ],
      "@velqu/core": [
        "packages/core/dist/index.d.ts"
      ],
      "@velqu/treaty": [
        "packages/treaty/dist/index.d.ts"
      ],
      "@velqu/browser-runtime": [
        "packages/browser-runtime/dist/index.d.ts"
      ],
      "@velqu/compiler": [
        "packages/compiler/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/index.ts"
  ]
}
