# Rust
target/
# target/dist holds release artifacts we DO track selectively; keep it tracked
!target/dist/

# Node/Bun
node_modules/
*.tsbuildinfo

# Generated app build output (rebuildable)
examples/proof/dist/
baselines/**/dist/

# Benchmark raw runs are tracked by milestone decisions; scratch ignored
benchmarks/raw/**/*.tmp
*.log.tmp

# OS
.DS_Store
packages/*/dist/
*.tsbuildinfo
*.zip
*.zip.sha256

# Release packets are generated post-commit, never tracked
release/
history/
*.bundle

# BETA-001-A real-world harness: bulky per-request raw smoke rows and logs
# (summary.json and report.md are retained as evidence; BETA-001-D owns the
# full raw-sample retention policy)
benchmarks/raw/real-world/smoke/raw.jsonl
benchmarks/raw/real-world/smoke/upstream.log
benchmarks/real-world/raw/
# BETA-001-D: retained raw-sample archives (.gz) ARE tracked; uncompressed
# rows and logs stay local
benchmarks/real-world/fairness.md
# BETA-002-C: contract-verification.md is tracked evidence; the upstream log
# is bulky local output (same policy as the smoke phase)
benchmarks/raw/real-world/contracts/upstream.log
