{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [
      "bun"
    ],
    "baseUrl": ".",
    "paths": {
      "@velqu/*": [
        "packages/*/src/index.ts"
      ]
    }
  }
}